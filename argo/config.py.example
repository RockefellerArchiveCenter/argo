ELASTICSEARCH_API_KEY = "" # String of encoded API Key provided by Elasticsearch. Use empty string if not authenticating
SQL_ENGINE = "django.db.backends.postgresql" # the database engine used by Argo (string, one of django.db.backends)
SQL_DATABASE = "postgres"  # name of the application database (string)
SQL_USER = "postgres"  # name of the application database user (string)
SQL_PASSWORD = "postgres"  # password for the application database (string)
SQL_HOST = "db"  # host for the application database (string)
SQL_PORT = "5432"  # port on which the application database can be reached (string)
USE_X_FORWARDED_HOST = 0 # Set to 1 if the application is behind a reverse proxy (1 for True, 0 for False)
SECURE_PROXY_SSL_HEADER = "HTTP_X_FORWARDED_PROTO,https" # If the application is being a reverse proxy, and if a header value indicates an HTTPS connection proxied over HTTP, name that header and value (comma-separated list of strings)
